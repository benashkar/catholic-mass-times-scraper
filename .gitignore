# ============================================================================
# Catholic Mass Times Scraper — Git Ignore Rules
# ============================================================================
# This file tells Git which files/folders to NOT track.
# Anything listed here stays on your local machine only.
# ============================================================================

# --- Environment & Secrets ---
# NEVER commit these — they contain passwords, API keys, etc.
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# --- Virtual Environment ---
# The venv folder contains installed packages — each developer creates their own
venv/
.venv/
env/
ENV/

# --- Logs ---
# Log files are generated locally and can get very large
logs/*.log
*.log
.auto_commit_bulletins.pid

# --- Temp chain scripts (auto-generated, not needed in repo) ---
auto_chain_*.sh
auto_pipeline_start.sh

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Data (large files) ---
# Raw downloaded PDFs and extracted text — too large for git
data/output/*/bulletins/
data/output/*/bulletin_texts/
# Large JSON files (bulletin discovery, progress, raw names JSON)
data/output/*/bulletin_names.json
data/output/*/bulletin_discovery.json
data/output/*/bulletin_progress.json
data/output/*/rescrape_progress.json
# Root-level aggregates (rebuilt from per-state files)
data/output/all_services.csv
data/output/all_churches_detail.json
data/output/dated_services.csv

# --- Docker ---
# docker-compose.override.yml

# --- OS files ---
nul
desktop.ini
