# ============================================================================
# Catholic Mass Times Scraper — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to git — it may contain secrets.
# The .gitignore file is already set up to exclude it.
# ============================================================================

# --- Scraper Settings ---
# How many seconds to wait between requests to be polite to the server
# Lower = faster but risks getting blocked; Higher = slower but safer
SCRAPE_DELAY_SECONDS=1.5

# Maximum number of times to retry a failed request before giving up
MAX_RETRIES=3

# User agent string sent with requests so the site knows who we are
# Be honest — pretending to be a browser is bad practice
USER_AGENT=CatholicMassTimesScraper/1.0 (CR Community News; contact: ben@healthyanalytics.com)

# --- Logging ---
# Minimum log level for console output: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL_CONSOLE=INFO

# Minimum log level for file output (logs/ folder)
LOG_LEVEL_FILE=DEBUG

# --- Email Alerts (Phase 4) ---
# ALERT_EMAIL_FROM=scraper@example.com
# ALERT_EMAIL_TO=ben@healthyanalytics.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Slack Alerts (Phase 4, optional) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Database (Phase 5+) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/mass_times
